    "Open Language & Region Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки языка и региона"
          }
        }
      }
    },
    "Restart MacPulse after changing the per-app language.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После смены языка приложения перезапустите MacPulse."
          }
        }
      }
    },
    "Startup": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать при входе"
          }
        }
      }
    },
    "macOS approval is required in Login Items.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение macOS в разделе объектов входа."
          }
        }
      }
    },
    "Desktop widget": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджет рабочего стола"
          }
        }
      }
    },
    "Add MacPulse from the macOS widget gallery. Widgets show timestamped snapshots and follow the system refresh budget; the menu bar provides live readings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте MacPulse из галереи виджетов macOS. Виджеты показывают снимки с отметкой времени и следуют системному интервалу обновления; Menu Bar показывает текущие данные."
          }
        }
      }
    },
    "Privacy & history": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфиденциальность и история"
          }
        }
      }
    },
    "All metrics stay on this Mac. History is limited to 900 samples and 30 minutes, and is cleared when MacPulse quits.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все показатели остаются на этом Mac. История ограничена 900 отсчётами и 30 минутами и очищается при выходе MacPulse."
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления"
          }
        }
      }
    },
    "Enable alerts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить предупреждения"
          }
        }
      }
    },
    "Conditions must persist for 30 seconds. At most one notification per condition per hour. Alerts are off by default.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Условие должно сохраняться 30 секунд. Не более одного уведомления на условие в час. Предупреждения выключены по умолчанию."
          }
        }
      }
    },
    "Thresholds": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пороги"
          }
        }
