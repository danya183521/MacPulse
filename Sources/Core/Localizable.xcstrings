    "%d seconds": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%d с"
          }
        }
      }
    },
    "2 seconds is a balanced default. Static information and Wi-Fi refresh every 15 samples. Sampling pauses during sleep.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2 секунды — сбалансированный интервал. Статические данные и Wi-Fi обновляются каждые 15 отсчётов. Во время сна отсчёты приостанавливаются."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление"
          }
        }
      }
