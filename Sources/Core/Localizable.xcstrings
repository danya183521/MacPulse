    "health.recommendation.closeProcess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is using much of the observed CPU. If its task is complete, closing it can reduce load and energy use."}},"ru":{"stringUnit":{"state":"translated","value":"%@ использует значительную часть наблюдаемого CPU. Если задача завершена, закрытие приложения может снизить нагрузку и энергопотребление."}}}},
    "health.recommendation.reduceCompute": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finish or pause compute-intensive work that is no longer needed."}},"ru":{"stringUnit":{"state":"translated","value":"Завершите или приостановите ресурсоёмкие задачи, которые больше не нужны."}}}},
    "health.recommendation.reduceGraphics": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pause graphics-intensive work that is no longer needed."}},"ru":{"stringUnit":{"state":"translated","value":"Приостановите ресурсоёмкую графическую задачу, если она больше не нужна."}}}},
    "health.recommendation.reduceMemory": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reduce memory pressure"}},"ru":{"stringUnit":{"state":"translated","value":"Снизить давление на память"}}}},
    "health.recommendation.closeMemoryProcess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is the largest observed memory consumer. Closing unneeded windows or work in it may reduce pressure."}},"ru":{"stringUnit":{"state":"translated","value":"%@ — крупнейший наблюдаемый потребитель памяти. Закрытие ненужных окон или задач может снизить давление."}}}},
    "health.recommendation.reduceMemoryGeneric": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Close unneeded apps, windows or large documents to reduce memory pressure."}},"ru":{"stringUnit":{"state":"translated","value":"Закройте ненужные приложения, окна или большие документы, чтобы снизить давление на память."}}}},
    "health.recommendation.coolMac": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reduce heat"}},"ru":{"stringUnit":{"state":"translated","value":"Снизить нагрев"}}}},
    "health.recommendation.coolBattery": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reduce battery heat"}},"ru":{"stringUnit":{"state":"translated","value":"Снизить нагрев аккумулятора"}}}},
    "health.recommendation.reduceThermalLoad": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reducing sustained workload and keeping vents unobstructed can help the Mac cool down."}},"ru":{"stringUnit":{"state":"translated","value":"Снижение длительной нагрузки и свободная вентиляция помогут Mac остыть."}}}},
    "health.recommendation.reduceEnergy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reduce energy use"}},"ru":{"stringUnit":{"state":"translated","value":"Снизить энергопотребление"}}}},
    "health.recommendation.energyProcess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is a leading observed energy user. Pause it if the current work is no longer needed."}},"ru":{"stringUnit":{"state":"translated","value":"%@ — один из главных наблюдаемых потребителей энергии. Приостановите его, если текущая задача больше не нужна."}}}},
    "health.recommendation.freeStorage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Free storage space"}},"ru":{"stringUnit":{"state":"translated","value":"Освободить место"}}}},
    "health.recommendation.freeStorageDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove or move files you no longer need so swap and system updates have working space."}},"ru":{"stringUnit":{"state":"translated","value":"Удалите или перенесите ненужные файлы, чтобы оставить место для swap и обновлений системы."}}}},
    "health.recommendation.reduceDisk": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reduce disk activity"}},"ru":{"stringUnit":{"state":"translated","value":"Снизить активность диска"}}}},
    "health.recommendation.diskProcess": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is producing much of the observed disk activity. Pause it if the operation is no longer needed."}},"ru":{"stringUnit":{"state":"translated","value":"%@ создаёт значительную часть наблюдаемой активности диска. Приостановите операцию, если она больше не нужна."}}}},
    "health.recommendation.reduceDiskGeneric": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow the current file operation to finish or pause it if it is no longer needed."}},"ru":{"stringUnit":{"state":"translated","value":"Дождитесь завершения текущей файловой операции или приостановите её, если она больше не нужна."}}}},
    "health.alert.highLoad": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"High Mac Load"}},"ru":{"stringUnit":{"state":"translated","value":"Высокая нагрузка на Mac"}}}},
